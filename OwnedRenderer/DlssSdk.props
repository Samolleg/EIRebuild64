<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DlssSdkRoot Condition="'$(DlssSdkRoot)'==''">$(MSBuildThisFileDirectory)..\dependencies\dlss\v310.9.16\</DlssSdkRoot>
    <DlssSdkRoot>$([MSBuild]::EnsureTrailingSlash('$(DlssSdkRoot)'))</DlssSdkRoot>
  </PropertyGroup>
  <PropertyGroup>
    <NgxLibrary>nvsdk_ngx_s.lib</NgxLibrary>
    <NgxLibrary Condition="'$(Configuration)'=='Debug'">nvsdk_ngx_s_dbg.lib</NgxLibrary>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(DlssSdkRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
    <Link><AdditionalDependencies>$(DlssSdkRoot)lib\Windows_x86_64\x64\$(NgxLibrary);%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <Target Name="VerifyDlssSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DlssSdkRoot)include\nvsdk_ngx_helpers_dlssd_d3d.h') Or !Exists('$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlssd.dll')" Text="DLSS Ray Reconstruction SDK files missing; run tools/prepare-worktree.ps1." />
    <Error Condition="!Exists('$(DlssSdkRoot)include\nvsdk_ngx.h') Or !Exists('$(DlssSdkRoot)include\nvsdk_ngx_helpers_d3d.h') Or !Exists('$(DlssSdkRoot)include\nvsdk_ngx_helpers_cuda.h') Or !Exists('$(DlssSdkRoot)lib\Windows_x86_64\x64\$(NgxLibrary)') Or !Exists('$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll') Or !Exists('$(DlssSdkRoot)include\nvsdk_ngx_helpers_dlssg_d3d.h') Or !Exists('$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlssg.dll') Or !Exists('$(DlssSdkRoot)LICENSE.txt')" Text="DLSS SDK v310.9.16 missing. Run tools/prepare-worktree.ps1 -DlssSdkSource &lt;SDK&gt; (or set EIREBUILD64_DLSS_SDK), or supply /p:DlssSdkRoot=&lt;SDK&gt;. Required: headers, x64 /MT nvsdk_ngx_s.lib, release nvngx_dlss.dll/nvngx_dlssg.dll, DLSS-G headers and LICENSE.txt." />
  </Target>
  <Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(ConfigurationType)'=='Application'">
    <Copy SourceFiles="$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlssd.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll;$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlssg.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(DlssSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)licenses\NVIDIA-DLSS-LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
</Project>
