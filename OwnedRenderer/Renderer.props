<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OwnedRendererRoot Condition="'$(OwnedRendererRoot)'==''">$(MSBuildThisFileDirectory)..\external\owned-renderer\</OwnedRendererRoot>
    <OwnedRendererRoot>$([MSBuild]::EnsureTrailingSlash('$(OwnedRendererRoot)'))</OwnedRendererRoot>
    <OutDir>$(MSBuildThisFileDirectory)..\out\Win32\Release\OwnedRenderer\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\out\obj\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling><PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel><ConformanceMode>true</ConformanceMode>
      <Optimization>MaxSpeed</Optimization><MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;DIRECTDRAW_VERSION=0x0700;DIRECT3D_VERSION=0x0700;EID3D11_BUILD_COMMIT=&quot;cbaf8ea9651651d7fa3576ac342867bab488c7f5&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OwnedRendererRoot)Source;$(OwnedRendererRoot)ThirdParty\imgui;$(OwnedRendererRoot)ThirdParty\imgui\backends;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="VerifyRendererIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)|$(Platform)'!='Release|Win32'" Text="Owned renderer is supported only in Release Win32." />
    <Exec Command="git -c safe.directory=* -C &quot;$(OwnedRendererRoot).&quot; rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="Low"><Output TaskParameter="ConsoleOutput" PropertyName="RendererActualCommit" /></Exec>
    <Error Condition="'$(RendererActualCommit)'!='cbaf8ea9651651d7fa3576ac342867bab488c7f5'" Text="Renderer source must be the pinned local c56-embed revision cbaf8ea9651651d7fa3576ac342867bab488c7f5." />
    <Exec Command="git -c safe.directory=* -C &quot;$(OwnedRendererRoot).&quot; diff --exit-code HEAD --" />
  </Target>
</Project>