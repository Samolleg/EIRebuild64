--toolchain=msvc
--arch=x86_64
--target-os=win32
--enable-shared
--disable-static
--disable-gpl
--disable-nonfree
--disable-version3
--disable-autodetect
--disable-everything
--disable-programs
--disable-doc
--disable-debug
--disable-network
--disable-avdevice
--disable-avfilter
--enable-avformat
--enable-avcodec
--enable-avutil
--enable-swscale
--enable-swresample
--enable-demuxer=bink
--enable-decoder=bink,binkaudio_rdft,binkaudio_dct
